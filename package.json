{
  "name": "next-personal-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-image-metadata.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-social-image.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "yarn generate:sitemap && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:social": "node scripts/generate-social-image.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:photos": "node scripts/check-image-metadata.mjs",
    "strip:photos": "node scripts/strip-image-metadata.mjs"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wasmboy": "^0.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.8",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
